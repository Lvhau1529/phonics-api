// Mô hình dữ liệu Phonics Arcade. Xem docs/architecture/erd.md.
// Prisma 7: URL kết nối nằm ở prisma.config.ts (CLI) và PrismaService (runtime, driver adapter pg).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum PermissionEffect {
  GRANT
  REVOKE
}

enum PointKind {
  GAME
  BONUS
}

enum UnlockSource {
  GEMS
  ADMIN
}

enum GameEventType {
  VIEW
  PLAY
}

enum NotificationType {
  BONUS_AWARDED
  RANK_CHANGED
  CLASS_CHANGED
  GAME_UNLOCKED
  SYSTEM
  ASSIGNMENT_NEW
  SUBMISSION_GRADED
  COMMENT_REPLY
}

// ---------- Phiếu bài tập (ADR 0017 / 0018 / 0019) ----------

enum MediaKind {
  IMAGE
  AUDIO
}

enum MediaStatus {
  PENDING
  READY
}

/// 14 dạng câu hỏi — khớp contracts QuestionType
enum QuestionType {
  MISSING_SOUND
  CROSSWORD
  UNSCRAMBLE_WORD
  PICK_LETTERS
  WORD_SEARCH
  ODD_ONE_OUT
  PATTERN_NEXT
  NUMBER_PICTURES
  MULTIPLE_CHOICE
  FILL_BLANK_WORD_BANK
  WORD_ORDER
  INLINE_CHOICE
  TRACE_AND_READ
  SPEAK
}

enum GradingMode {
  AUTO
  MANUAL
}

/// Vòng đời câu hỏi / phiếu
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PRIVATE
  SHARED
}

enum Subject {
  PHONICS
  ESL
}

enum WorksheetKind {
  EXTRA
  HANDOUT
  WORKSHEET
}

enum AssignmentStatus {
  SCHEDULED
  OPEN
  CLOSED
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

/// Tài khoản chung cho admin / giáo viên / học sinh
model User {
  id            String       @id @default(uuid()) @db.Uuid
  /// Lưu chữ thường, đã trim
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  /// null với tài khoản chỉ đăng nhập Google
  passwordHash  String?      @map("password_hash")
  googleSub     String?      @unique @map("google_sub")
  provider      AuthProvider @default(LOCAL)
  role          Role
  status        UserStatus   @default(ACTIVE)
  displayName   String       @map("display_name")
  /// Key avatar preset (contracts AVATARS)
  avatarKey     String       @default("pip") @map("avatar_key")
  /// Tăng để vô hiệu mọi access token đang có
  tokenVersion  Int          @default(0) @map("token_version")
  lastLoginAt   DateTime?    @map("last_login_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  studentProfile   StudentProfile?
  teachingClasses  ClassTeacher[]
  permissions      UserPermission[]   @relation("UserPermissions")
  permissionGroups UserPermissionGroup[]
  grantedPerms     UserPermission[]   @relation("GrantedBy")
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  pointEntriesMade PointEntry[]       @relation("PointEntryCreatedBy")
  unlocksGranted   StudentGameUnlock[] @relation("UnlockGrantedBy")
  auditLogs        AuditLog[]
  gameEvents       GameEvent[]
  mediaAssets       MediaAsset[]       @relation("MediaOwner")
  questionsCreated  Question[]         @relation("QuestionCreatedBy")
  worksheetsCreated Worksheet[]        @relation("WorksheetCreatedBy")
  assignmentsMade   Assignment[]       @relation("AssignmentAssignedBy")
  submissionsGraded Submission[]       @relation("SubmissionGradedBy")
  answersGraded     SubmissionAnswer[] @relation("AnswerGradedBy")
  comments          Comment[]          @relation("CommentAuthor")

  @@index([role, status])
  @@map("users")
}

/// Thông tin riêng của học sinh (liên hệ phụ huynh)
model StudentProfile {
  userId      String   @id @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentName  String?  @map("parent_name")
  parentEmail String?  @map("parent_email")
  parentPhone String?  @map("parent_phone")
  /// Ghi chú nội bộ của admin
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships  ClassMembership[]
  gameResults  GameResult[]
  pointEntries PointEntry[]
  gameUnlocks  StudentGameUnlock[]
  submissions  Submission[]

  @@map("student_profiles")
}

model Class {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  /// "K2", "Lớp 1"… — text tự do, lọc được
  grade       String
  /// "2026-2027"
  schoolYear  String    @map("school_year")
  /// Hiện ở danh sách lớp khi học sinh đăng ký
  joinVisible Boolean   @default(true) @map("join_visible")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  teachers     ClassTeacher[]
  memberships  ClassMembership[]
  pointEntries PointEntry[]
  gameResults  GameResult[]
  assignments  Assignment[]

  @@unique([name, schoolYear])
  @@index([joinVisible, archivedAt])
  @@map("classes")
}

/// Giáo viên dạy lớp (nhiều-nhiều)
model ClassTeacher {
  classId    String   @map("class_id") @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([classId, teacherId])
  @@index([teacherId])
  @@map("class_teachers")
}

/// Học sinh thuộc lớp. Mỗi học sinh chỉ có MỘT membership đang hoạt động (left_at IS NULL):
/// partial unique index `class_memberships_active_student` được thêm tay trong migration SQL.
model ClassMembership {
  id         String    @id @default(uuid()) @db.Uuid
  studentId  String    @map("student_id") @db.Uuid
  classId    String    @map("class_id") @db.Uuid
  joinedAt   DateTime  @default(now()) @map("joined_at")
  leftAt     DateTime? @map("left_at")
  /// Hạng (tổng điểm, mọi thời gian) ở lần tính gần nhất — để phát hiện đổi hạng
  lastRank   Int?      @map("last_rank")
  lastRankAt DateTime? @map("last_rank_at")
  student    StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  class      Class          @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, leftAt])
  @@index([studentId, leftAt])
  @@map("class_memberships")
}

/// Override quyền theo user; catalog quyền nằm trong packages/contracts (PERMISSIONS)
model UserPermission {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  permission  String
  effect      PermissionEffect
  grantedById String?          @map("granted_by_id") @db.Uuid
  note        String?
  createdAt   DateTime         @default(now()) @map("created_at")
  user        User             @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?            @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, permission])
  @@map("user_permissions")
}

/// Nhóm quyền do admin tạo từ catalog PERMISSIONS (contracts); gán cho user qua user_permission_groups
model PermissionGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  /// Mã quyền (contracts PermissionCode); mã lạ bị bỏ qua khi tính quyền hiệu lực
  permissions String[] @default([])
  /// Seed sẵn: không xoá được
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members UserPermissionGroup[]

  @@map("permission_groups")
}

model UserPermissionGroup {
  userId     String   @map("user_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("user_permission_groups")
}

/// Catalog game: id = manifest.id ở app game. Seed từ contracts GAME_IDS.
model Game {
  id         String   @id
  title      String
  enabled    Boolean  @default(true)
  comingSoon Boolean  @default(false) @map("coming_soon")
  /// Số kim cương để mở khoá; null = miễn phí
  price      Int?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  unlocks StudentGameUnlock[]
  events  GameEvent[]
  results GameResult[]
  points  PointEntry[]

  @@map("games")
}

/// Học sinh đã mở khoá game (bằng kim cương ở client hoặc admin cấp). revoked_at != null = bị thu hồi.
model StudentGameUnlock {
  studentId   String       @map("student_id") @db.Uuid
  gameId      String       @map("game_id")
  source      UnlockSource
  gemsSpent   Int?         @map("gems_spent")
  grantedById String?      @map("granted_by_id") @db.Uuid
  note        String?
  unlockedAt  DateTime     @default(now()) @map("unlocked_at")
  revokedAt   DateTime?    @map("revoked_at")
  student     StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  game        Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  grantedBy   User?          @relation("UnlockGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([studentId, gameId])
  @@index([gameId, revokedAt])
  @@map("student_game_unlocks")
}

/// Lượt xem (click thẻ game) / lượt chơi (hoàn thành ván), ẩn danh theo client_id; user_id nếu đã đăng nhập
model GameEvent {
  id         String        @id @default(uuid()) @db.Uuid
  gameId     String        @map("game_id")
  type       GameEventType
  userId     String?       @map("user_id") @db.Uuid
  clientId   String        @map("client_id") @db.Uuid
  /// 'solo' | 'class'
  mode       String?
  /// Làm tròn giây (dedupe)
  occurredAt DateTime      @map("occurred_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  game       Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([clientId, gameId, type, occurredAt])
  @@index([gameId, type, occurredAt])
  @@index([userId, occurredAt])
  @@map("game_events")
}

/// Kết quả một ván SOLO do game client gửi
model GameResult {
  id              String   @id @default(uuid()) @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  /// Lớp tại thời điểm chơi (null nếu chưa vào lớp)
  classId         String?  @map("class_id") @db.Uuid
  gameId          String   @map("game_id")
  mode            String   @default("solo")
  levelId         String   @map("level_id")
  packId          String?  @map("pack_id")
  correct         Int
  total           Int
  score           Int
  durationMs      Int?     @map("duration_ms")
  endedBy         String   @map("ended_by")
  playedAt        DateTime @map("played_at")
  /// Khoá idempotent do client sinh
  clientSessionId String   @map("client_session_id") @db.Uuid
  pointsAwarded   Int      @default(0) @map("points_awarded")
  pointsReason    String?  @map("points_reason")
  details         Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  student         StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  class           Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  game            Game           @relation(fields: [gameId], references: [id], onDelete: Restrict)
  pointEntry      PointEntry?

  @@unique([studentId, clientSessionId])
  @@index([studentId, playedAt])
  @@index([gameId, playedAt])
  @@map("game_results")
}

/// Sổ điểm (ledger). Tổng điểm học sinh = SUM(points); điểm đi theo học sinh khi đổi lớp.
model PointEntry {
  id           String    @id @default(uuid()) @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  /// Lớp tại thời điểm cộng (để báo cáo), có thể null
  classId      String?   @map("class_id") @db.Uuid
  /// GAME: bắt buộc; BONUS: tuỳ chọn (thưởng theo game)
  gameId       String?   @map("game_id")
  kind         PointKind
  /// BONUS có thể âm (sửa điểm)
  points       Int
  note         String?
  gameResultId String?   @unique @map("game_result_id") @db.Uuid
  /// null = hệ thống (game)
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  student      StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  class        Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  game         Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  gameResult   GameResult?    @relation(fields: [gameResultId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("PointEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([classId, createdAt])
  @@index([gameId, createdAt])
  @@index([kind, createdAt])
  @@map("point_entries")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Refresh token: lưu hash, xoay vòng mỗi lần dùng, phát hiện dùng lại theo family
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Nhật ký hành động của admin / giáo viên
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------- Phiếu bài tập ----------

/// File do giáo viên / học sinh tải lên Neon Object Storage (bucket `resources`). API không chạm byte:
/// presign PUT → client PUT → POST complete (server HEAD đối tượng rồi đánh dấu READY). PENDING quá 24h bị cron xoá.
model MediaAsset {
  id         String      @id @default(uuid()) @db.Uuid
  ownerId    String      @map("owner_id") @db.Uuid
  kind       MediaKind
  /// `media/{ownerId}/{uuid}.{ext}` — bất biến
  key        String      @unique
  /// URL public (bucket public_read); null khi PENDING
  url        String?
  mimeType   String      @map("mime_type")
  sizeBytes  Int         @map("size_bytes")
  width      Int?
  height     Int?
  durationMs Int?        @map("duration_ms")
  status     MediaStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at")
  readyAt    DateTime?   @map("ready_at")
  owner      User        @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@map("media_assets")
}

/// Ngân hàng câu hỏi. `config` / `answerKey` là JSON theo discriminated union trong contracts (khoá `type`).
/// Không xoá cứng (worksheet_items tham chiếu), chỉ ARCHIVED. GIN index trên tags thêm tay trong migration.
model Question {
  id            String        @id @default(uuid()) @db.Uuid
  type          QuestionType
  gradingMode   GradingMode   @map("grading_mode")
  instruction   String
  instructionVi String?       @map("instruction_vi")
  points        Int           @default(1)
  tags          String[]      @default([])
  /// Ví dụ mẫu "E.g." (contracts QuestionExample)
  example       Json?
  config        Json
  answerKey     Json          @map("answer_key")
  status        ContentStatus @default(DRAFT)
  visibility    Visibility    @default(SHARED)
  createdById   String        @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  createdBy     User          @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items         WorksheetItem[]

  @@index([createdById, status])
  @@index([type, status])
  @@index([visibility, status])
  @@map("questions")
}

/// Phiếu bài tập: metadata + Part (section) + câu (item)
model Worksheet {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  subject     Subject       @default(PHONICS)
  /// "Letter Nn"
  topic       String?
  grade       String?
  week        Int?
  /// 1..5 (D1..D5)
  day         Int?
  kind        WorksheetKind @default(WORKSHEET)
  status      ContentStatus @default(DRAFT)
  visibility  Visibility    @default(SHARED)
  note        String?
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  createdBy   User          @relation("WorksheetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sections    WorksheetSection[]
  items       WorksheetItem[]
  assignments Assignment[]

  @@index([createdById, status])
  @@index([status, visibility])
  @@index([grade, week, day])
  @@map("worksheets")
}

model WorksheetSection {
  id          String    @id @default(uuid()) @db.Uuid
  worksheetId String    @map("worksheet_id") @db.Uuid
  order       Int
  /// "Part 1"
  title       String
  instruction String?
  worksheet   Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  items       WorksheetItem[]

  @@index([worksheetId, order])
  @@map("worksheet_sections")
}

/// Một câu trong phiếu. Id của item là khoá ổn định mà snapshot / submission_answers tham chiếu (không FK).
model WorksheetItem {
  id             String           @id @default(uuid()) @db.Uuid
  worksheetId    String           @map("worksheet_id") @db.Uuid
  sectionId      String           @map("section_id") @db.Uuid
  questionId     String           @map("question_id") @db.Uuid
  order          Int
  pointsOverride Int?             @map("points_override")
  worksheet      Worksheet        @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  section        WorksheetSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question       Question         @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([sectionId, order])
  @@index([questionId])
  @@map("worksheet_items")
}

/// Giao phiếu cho lớp. `snapshot` = toàn bộ nội dung phiếu + câu hỏi (config, answerKey, points) đóng băng lúc giao
/// → sửa phiếu / câu hỏi sau đó không đổi bài đã chấm.
model Assignment {
  id                     String           @id @default(uuid()) @db.Uuid
  worksheetId            String           @map("worksheet_id") @db.Uuid
  classId                String           @map("class_id") @db.Uuid
  assignedById           String           @map("assigned_by_id") @db.Uuid
  /// Ngày trên lịch (APP_TIMEZONE)
  scheduledFor           DateTime         @map("scheduled_for") @db.Date
  availableFrom          DateTime         @map("available_from")
  dueAt                  DateTime?        @map("due_at")
  allowLate              Boolean          @default(false) @map("allow_late")
  maxAttempts            Int              @default(1) @map("max_attempts")
  showAnswersAfterSubmit Boolean          @default(false) @map("show_answers_after_submit")
  status                 AssignmentStatus @default(SCHEDULED)
  /// contracts WorksheetSnapshot — có answerKey, KHÔNG trả thẳng cho học sinh
  snapshot               Json
  /// Tổng điểm tối đa, tính lúc snapshot
  maxScore               Int              @map("max_score")
  /// Có câu chấm tay → nộp xong ở SUBMITTED chờ GV
  hasManualItems         Boolean          @map("has_manual_items")
  openedAt               DateTime?        @map("opened_at")
  closedAt               DateTime?        @map("closed_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  worksheet              Worksheet        @relation(fields: [worksheetId], references: [id], onDelete: Restrict)
  class                  Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignedBy             User             @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  submissions            Submission[]

  @@index([classId, scheduledFor])
  @@index([status, availableFrom])
  @@index([status, dueAt])
  @@index([worksheetId])
  @@map("assignments")
}

/// Một lần làm bài. Partial unique `submissions_one_in_progress (assignment_id, student_id) WHERE status = 'IN_PROGRESS'`
/// thêm tay trong migration.
model Submission {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @map("assignment_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  attemptNo    Int              @map("attempt_no")
  status       SubmissionStatus @default(IN_PROGRESS)
  startedAt    DateTime         @default(now()) @map("started_at")
  submittedAt  DateTime?        @map("submitted_at")
  gradedAt     DateTime?        @map("graded_at")
  gradedById   String?          @map("graded_by_id") @db.Uuid
  /// Tổng điểm phần tự chấm (sau submit)
  autoScore    Float            @default(0) @map("auto_score")
  /// Tổng điểm GV chấm / ghi đè (sau finalize)
  manualScore  Float?           @map("manual_score")
  /// Chỉ có khi GRADED
  totalScore   Float?           @map("total_score")
  maxScore     Int              @map("max_score")
  durationMs   Int?             @map("duration_ms")
  late         Boolean          @default(false)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      StudentProfile   @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  gradedBy     User?            @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)
  answers      SubmissionAnswer[]
  comments     Comment[]

  @@unique([assignmentId, studentId, attemptNo])
  @@index([assignmentId, status, totalScore(sort: Desc), durationMs])
  @@index([studentId, status, submittedAt])
  @@map("submissions")
}

/// Câu trả lời của một item trong snapshot (không FK — item có thể bị xoá khỏi phiếu gốc sau này)
model SubmissionAnswer {
  id              String       @id @default(uuid()) @db.Uuid
  submissionId    String       @map("submission_id") @db.Uuid
  worksheetItemId String       @map("worksheet_item_id") @db.Uuid
  /// Denormalize từ snapshot để thống kê theo dạng câu bằng SQL
  questionType    QuestionType @map("question_type")
  maxPoints       Int          @map("max_points")
  answer          Json
  isCorrect       Boolean?     @map("is_correct")
  autoScore       Float?       @map("auto_score")
  /// Điểm GV chấm (MANUAL) hoặc ghi đè (AUTO); ưu tiên hơn autoScore khi tính tổng
  manualScore     Float?       @map("manual_score")
  gradedById      String?      @map("graded_by_id") @db.Uuid
  gradedAt        DateTime?    @map("graded_at")
  teacherNote     String?      @map("teacher_note")
  /// Chi tiết chấm tự động (phần nào đúng)
  gradeDetail     Json?        @map("grade_detail")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  submission      Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedBy        User?        @relation("AnswerGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([submissionId, worksheetItemId])
  @@index([questionType, isCorrect])
  @@map("submission_answers")
}

/// Nhận xét theo bài nộp / theo câu; học sinh trả lời được; một cấp (parent_id chỉ trỏ tới comment gốc)
model Comment {
  id              String     @id @default(uuid()) @db.Uuid
  submissionId    String     @map("submission_id") @db.Uuid
  worksheetItemId String?    @map("worksheet_item_id") @db.Uuid
  authorId        String     @map("author_id") @db.Uuid
  parentId        String?    @map("parent_id") @db.Uuid
  body            String
  createdAt       DateTime   @default(now()) @map("created_at")
  editedAt        DateTime?  @map("edited_at")
  deletedAt       DateTime?  @map("deleted_at")
  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author          User       @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent          Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Comment[]  @relation("CommentReplies")

  @@index([submissionId, createdAt])
  @@index([parentId])
  @@map("submission_comments")
}
