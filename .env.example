# Sao chép thành .env (không commit). Xem docs/architecture/deployment.md.
NODE_ENV=development
PORT=3000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Dev: Postgres của `pnpm docker:dev` (docker-compose.dev.yml, mở localhost:5432).
# Production (VPS): KHÔNG khai báo ở .env.production — docker-compose.yml tự đặt DATABASE_URL / DIRECT_URL /
# API_PUBLIC_URL / MEDIA_DIR từ API_DOMAIN + POSTGRES_PASSWORD trong file .env của compose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phonics
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/phonics

# >= 32 ký tự ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_SECRET=change-me-change-me-change-me-change-me
# COOKIE_DOMAIN=.example.vn

# Origin được gọi API (game, admin), cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# OAuth Web Client ID của Google (game + admin), cách nhau bằng dấu phẩy; để trống = tắt đăng nhập Google
GOOGLE_CLIENT_IDS=

# Tài khoản admin được seed (prisma db seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-123
# SEED_DEMO=true  # dữ liệu mẫu (chỉ dev)

SWAGGER_ENABLED=true
LOG_LEVEL=info

# Ảnh / audio phiếu bài tập: MEDIA_STORAGE=disk (mặc định, ADR 0024) hoặc r2 (Cloudflare R2, README > Media trên
# Cloudflare R2). URL public của API (không có /api) để dựng link upload / file; dev mặc định http://localhost:$PORT.
# API_PUBLIC_URL=http://localhost:3000
MEDIA_PRESIGN_TTL_SEC=900
# MEDIA_STORAGE=disk
# disk: MEDIA_DIR mặc định storage/media (gitignored); MEDIA_PUBLIC_BASE_URL tuỳ chọn (CDN)
# MEDIA_DIR=storage/media
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.vn/files
# r2: bắt buộc cả 5 biến dưới; MEDIA_PUBLIC_BASE_URL = custom domain / r2.dev của bucket
# MEDIA_STORAGE=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=phonics-media
# MEDIA_PUBLIC_BASE_URL=https://media.example.vn

# Gửi mail: MAIL_DRIVER=log (mặc định — ghi file .eml vào MAIL_LOG_DIR, không gửi thật) hoặc smtp.
# Kiểm tra: pnpm mail:test ban@example.com
# MAIL_DRIVER=smtp
# MAIL_FROM=Phonics <no-reply@example.vn>
# MAIL_LOG_DIR=storage/mail
# SMTP_HOST=smtp.example.vn
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# URL game: link trong mail phụ huynh (đặt mật khẩu tài khoản gia đình). Bắt buộc ở production.
# GAME_APP_URL=https://game.example.vn
