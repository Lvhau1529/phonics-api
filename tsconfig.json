{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // NestJS cần decorator metadata → TypeScript 6 (classic); TS 7 chưa có compiler API cho nest build
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // import '@/modules/...' thay cho '../../modules/...'; khai báo tương ứng ở .swcrc (build) và vitest.config.ts (test)
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
