# Reverse proxy + HTTPS tự động (Let's Encrypt) cho API — service `caddy` trong docker-compose.yml.
# API_DOMAIN đặt trong file .env cạnh docker-compose.yml trên VPS (vd api.example.vn, api.1-2-3-4.sslip.io).
# DNS của domain phải trỏ về IP VPS (hoặc qua proxy Cloudflare) và cổng 80 / 443 phải mở thì Caddy mới lấy được
# chứng chỉ.
{
	servers {
		# API đứng sau proxy Cloudflare (đám mây cam): chỉ tin IP của Cloudflare (https://www.cloudflare.com/ips/,
		# cập nhật khi Cloudflare đổi dải) và lấy IP thật của người dùng từ CF-Connecting-IP. Request đi thẳng vào
		# VPS không qua Cloudflare thì header đó bị bỏ qua — không giả IP được.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

{$API_DOMAIN} {
	encode gzip
	reverse_proxy api:3000 {
		# API (`trust proxy` 1) lấy IP client = phần tử cuối của X-Forwarded-For → chỉ gửi đúng IP thật, không nối
		# thêm IP Cloudflare (mặc định Caddy giữ X-Forwarded-For từ proxy tin cậy rồi nối remote IP vào cuối)
		header_up X-Forwarded-For {client_ip}
	}
}
